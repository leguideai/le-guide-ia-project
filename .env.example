# Google Sheets auth for /api/register on Cloudflare
# Use ONE of the two options below.

# Option 1: single JSON string from your Google service account key
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option 2: split values
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional alias supported by the app
GOOGLE_PRIVATE_KEY=

# The spreadsheet ID is currently hardcoded in app/api/register/route.ts
# SPREADSHEET_ID=1lGRCyx9i5eAiEsj78YKBb6pk3yqf-kFQ_EE2pd3D2Ho

# Cloudflare R2 — stockage des vidéos (replays bootcamps & masterclasses)
# Dashboard Cloudflare → R2 → Manage API tokens (droits "Object Read & Write" sur le bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Domaine public connecté au bucket (pas l'URL r2.dev, limitée en débit)
R2_PUBLIC_BASE_URL=https://media.leguideia.ai
